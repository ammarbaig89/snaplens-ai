{
  "expo": {
    "name": "SnapLens AI",
    "slug": "snaplens-ai",
    "version": "0.1.0",
    "icon": "./assets/snaplens-eye.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/snaplens-eye.png",
      "resizeMode": "contain",
      "backgroundColor": "#EAF0F8"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/snaplens-eye.png",
        "backgroundColor": "#EAF0F8"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "SnapLens uses your selected photo to help identify a device or error code.",
          "cameraPermission": "SnapLens uses your camera to take a troubleshooting photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "SnapLens uses your microphone only while Voice Assistant is enabled.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset"
    ]
  }
}
