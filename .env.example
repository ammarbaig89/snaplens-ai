# SnapLens AI environment template
# Copy this file to .env for local configuration. Never commit .env or real keys.

# Shared upload setting
MAX_IMAGE_BYTES=10485760

# API Gateway
ORCHESTRATOR_URL=http://diagnostic-orchestrator:8001
HTTP_TIMEOUT_SECONDS=90

# Deepgram app-wide voice assistant (credentials stay on the Gateway)
VOICE_ASSISTANT_ENABLED=false
DEEPGRAM_API_KEY=
VOICE_ASSISTANT_MAX_CONCURRENT_SESSIONS=2
VOICE_ASSISTANT_MAX_SESSION_SECONDS=600
DEEPGRAM_LISTEN_MODEL=flux-general-en
DEEPGRAM_THINK_PROVIDER=open_ai
DEEPGRAM_THINK_MODEL=gpt-4o-mini
DEEPGRAM_THINK_TEMPERATURE=0.3
DEEPGRAM_SPEAK_MODEL=aura-2-thalia-en
DEEPGRAM_VOICE_LANGUAGE=en
DEEPGRAM_VOICE_GREETING=Hi, I'm SnapLens. I can help you use the app or troubleshoot a photo. What would you like to do?

# Vision Service (active)
VISION_PROVIDER=mock
VISION_PROVIDER_TIMEOUT_SECONDS=30
VISION_MAX_OUTPUT_TOKENS=512
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Internal service addresses (reserved until Orchestrator integration)
VISION_SERVICE_URL=http://vision-service:8002
RETRIEVAL_SERVICE_URL=http://retrieval-service:8003
SESSION_SERVICE_URL=http://session-service:8004

# Retrieval Service
RETRIEVAL_PROVIDER=mock
RETRIEVAL_PROVIDER_TIMEOUT_SECONDS=15
RETRIEVAL_MAX_SNIPPET_CHARS=4000
TAVILY_API_KEY=
TAVILY_API_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_DEPTH=basic

# Orchestrator answer synthesis
ANSWER_PROVIDER=mock
ANSWER_MODEL=gemini-3.1-flash-lite
ANSWER_PROVIDER_TIMEOUT_SECONDS=30
ANSWER_MAX_OUTPUT_TOKENS=1024
ORCHESTRATOR_SERVICE_TIMEOUT_SECONDS=35

# Session Service and local data stores (deferred; Docker is optional)
POSTGRES_DB=snaplens
POSTGRES_USER=snaplens
POSTGRES_PASSWORD=change-this-local-password
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://snaplens:change-this-local-password@localhost:5432/snaplens

# Observability (reserved for the reliability phase)
OTEL_SERVICE_NAME=snaplens
OTEL_EXPORTER_OTLP_ENDPOINT=

# Mobile app (public URL only; never put provider keys in Expo variables)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
